rules_version = '2';

// 설계 원문: docs/days/infra-and-billing-protection.md 2-2 · 2-3. 공개 읽기 · 공개 URL은 만들지 않는다.
// firestore.get()은 Firestore 읽기로 과금된다: 읽기 1번(couple), 새로 만들기 2번(couple + usage).
service firebase.storage {
  match /b/{bucket}/o {
    match /couples/{coupleId}/images/{fileName} {
      function couple() {
        return firestore.get(/databases/(default)/documents/couples/$(coupleId)).data;
      }
      function isMember() {
        return request.auth != null && request.auth.uid in couple().members;
      }
      // 방금 카운터를 +1 하며 등록한 사진(lastImageId)의 파일만 새로 만든다 (+1 한 번에 파일 1개)
      function claimedFileName() {
        return firestore.get(/databases/(default)/documents/couples/$(coupleId)/usage/images).data.lastImageId + '.webp';
      }

      // 해제된 커플의 멤버도 읽는다: 해제 때 만든 나만 보기 사본이 아직 받지 않은 배경 사진을 가리킬 수 있다
      allow read: if isMember();
      allow create: if resource == null
        && isMember()
        && couple().status == 'ACTIVE'
        && request.resource.contentType == 'image/webp'
        && request.resource.size <= 300 * 1024
        && fileName == claimedFileName();
      // 덮어쓰기는 막는다 (같은 id로 내용을 바꿔 한도를 우회하지 못하게)
      allow update: if false;
      allow delete: if isMember();
    }
  }
}
