rules_version = '2';

// 설계 원문: docs/days/sync-and-pairing.md 4장. Blaze라 규칙이 곧 과금 방어다 (firebase/CLAUDE.md).
// get() · getAfter()도 문서 읽기로 과금되므로 호출 수를 늘릴 때는 이유를 주석으로 남긴다.
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function coupleDoc(id) { return /databases/$(db)/documents/couples/$(id); }
    function couple(id) { return get(coupleDoc(id)).data; }
    function isMember(id) { return signedIn() && me() in couple(id).members; }
    function isActive(id) { return couple(id).status == 'ACTIVE'; }
    function userDoc(uid) { return get(/databases/$(db)/documents/users/$(uid)).data; }
    function pairCodeAfter(code) { return getAfter(/databases/$(db)/documents/pairCodes/$(code)).data; }
    function reconnectedWithCode(code, members) {
      return pairCodeAfter(code).usedBy == me()
        && pairCodeAfter(code).creatorUid != me()
        && pairCodeAfter(code).creatorUid in members;
    }

    match /users/{uid} {
      // 나, 또는 같은 커플에 연결된 상대만 읽는다
      allow read: if signedIn() && (me() == uid ||
        (userDoc(me()).coupleId != null && userDoc(me()).coupleId == userDoc(uid).coupleId));
      // coupleId는 null이거나 내가 멤버인 커플만. 남의 커플 id를 적어 상대 프로필을 읽는 것을 막는다
      // (문서 초안에 없던 검사: coupleId를 바꿀 때만 get 1회 추가)
      // serverUpdatedAt은 서버 시각만: 상대 기기의 프로필 반영 순서가 틀어지지 않게 한다. 실제 삭제는 탈퇴(7단계)에서 다룬다
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.serverUpdatedAt == request.time && (
        request.resource.data.get('coupleId', null) == null ||
        request.resource.data.get('coupleId', null) == resource.data.get('coupleId', null) ||
        me() in couple(request.resource.data.coupleId).members);
      allow delete: if signedIn() && me() == uid;
    }

    match /pairCodes/{code} {
      // 코드를 아는 사람만 조회. 목록 조회는 막는다
      allow get: if signedIn();
      allow list: if false;
      // creatorNickname: 코드를 입력한 사람의 확인 화면에 보일 발급자 이름 (연결 전에는 users 문서를 읽을 수 없음)
      allow create: if signedIn()
        && request.resource.data.creatorUid == me()
        && request.resource.data.creatorNickname is string
        && request.resource.data.creatorNickname.size() >= 1
        && request.resource.data.creatorNickname.size() <= 10
        && request.resource.data.expiresAt > request.time.toMillis()
        && !('usedBy' in request.resource.data);
      // 상대가 코드를 "사용함"으로 표시: 한 번만, 본인 uid로만, 만료 전에만, 발급자는 불가
      allow update: if signedIn()
        && !('usedBy' in resource.data)
        && resource.data.creatorUid != me()
        && resource.data.expiresAt > request.time.toMillis()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy'])
        && request.resource.data.usedBy == me();
      // 발급자 본인 또는 만료된 코드만 삭제 (TTL이 유료라 앱이 지운다)
      allow delete: if signedIn()
        && (resource.data.creatorUid == me()
            || resource.data.expiresAt < request.time.toMillis());
    }

    match /couples/{coupleId} {
      allow get, list: if signedIn() && me() in resource.data.members;
      // 코드를 쓴 사람(members[1])이 같은 트랜잭션에서 pairCodes.usedBy를 기록한 경우에만 만든다
      allow create: if signedIn()
        && request.resource.data.members.size() == 2
        && request.resource.data.members[1] == me()
        && request.resource.data.members[0] != me()
        && request.resource.data.status == 'ACTIVE'
        && getAfter(/databases/$(db)/documents/pairCodes/$(request.resource.data.pairCode)).data.creatorUid
             == request.resource.data.members[0]
        && getAfter(/databases/$(db)/documents/pairCodes/$(request.resource.data.pairCode)).data.usedBy
             == me();
      // 멤버는 사귄 날 · 상태(해제)를 바꿀 수 있지만 멤버 구성은 못 바꾼다.
      // 해제된 커플을 다시 ACTIVE로(30일 안 재연결)는 상대가 발급한 코드를 같은 트랜잭션에서 쓴 경우에만
      // (한쪽이 혼자 되살리는 것을 막음. 재연결 때만 getAfter 2회)
      allow update: if signedIn() && me() in resource.data.members
        && request.resource.data.members == resource.data.members
        && (resource.data.status == 'ACTIVE' || request.resource.data.status != 'ACTIVE'
            || reconnectedWithCode(request.resource.data.pairCode, resource.data.members));
      allow delete: if false;

      match /items/{itemId} {
        allow read: if isMember(coupleId);
        // serverUpdatedAt은 서버 시각만: 상대 기기의 변경분 조회 커서(serverUpdatedAt > cursor)가 틀어지지 않게 한다
        allow create, update: if isMember(coupleId) && isActive(coupleId)
          && request.resource.data.updatedBy == me()
          && request.resource.data.visibility == 'SHARED'
          && request.resource.data.serverUpdatedAt == request.time;
        // soft delete(deletedAt)만 허용
        allow delete: if false;
      }

      // 사진 업로드 한도 (infra-and-billing-protection.md 2-3): 커플당 누적 30번 + 보상형 광고로 받은 bonus.
      // count는 1씩만 늘고 줄지 않는다. lastImageId는 방금 등록한 사진 id로, Storage 규칙이 그 id의 파일만 새로 만들게 한다
      // (+1 한 번에 파일 1개. Storage 규칙의 firestore.get이 이 문서를 읽는다)
      // bonus는 admobReward 함수(AdMob 서버 측 확인)만 올린다. 앱은 바꿀 수 없다. 함수가 먼저 만든 문서에는 count가 없을 수 있다
      match /usage/{usageId} {
        function validImageClaim(next, bonus) {
          return usageId == 'images'
            && request.resource.data.keys().hasOnly(['count', 'lastImageId', 'bonus'])
            && request.resource.data.get('bonus', 0) == bonus
            && request.resource.data.count == next
            && request.resource.data.count <= 30 + bonus
            && request.resource.data.lastImageId is string
            && request.resource.data.lastImageId.matches('^[0-9a-f-]{36}$');
        }
        allow read: if isMember(coupleId);
        allow create: if isMember(coupleId) && isActive(coupleId) && validImageClaim(1, 0);
        allow update: if isMember(coupleId) && isActive(coupleId)
          && validImageClaim(resource.data.get('count', 0) + 1, resource.data.get('bonus', 0));
        allow delete: if false;
      }

      // 숨긴 자동 기념일. 숨김 해제도 deletedAt 기록(soft delete): 상대 기기가 변경분 조회로 받아야 한다
      match /hiddenAnniversaries/{ruleKey} {
        allow read: if isMember(coupleId);
        allow create, update: if isMember(coupleId) && isActive(coupleId)
          && request.resource.data.serverUpdatedAt == request.time;
        allow delete: if false;
      }
    }
  }
}
